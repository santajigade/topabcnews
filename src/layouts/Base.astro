---
import { SITE, CATEGORIES, NAV, SOCIAL, catBySlug } from '../lib/site';
import '../styles/global.css';
interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: string; jsonld?: object; noindex?: boolean;
  publishedTime?: Date; modifiedTime?: Date; section?: string; tags?: string[]; keywords?: string;
}
const { title, description, image, imageAlt, type = 'website', jsonld, noindex, publishedTime, modifiedTime, section, tags = [], keywords } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? '/og-default.png', SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
const year = new Date().getFullYear();
const ICONS: Record<string, string> = {
  Facebook: 'M14 8.5V6.6c0-.8.2-1.3 1.4-1.3H17V2.2C16.7 2.1 15.7 2 14.6 2 12.2 2 10.6 3.4 10.6 6.1v2.4H8v3.3h2.6V22H14V11.8h2.7l.4-3.3H14z',
  Instagram: 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.7a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2zm0 8.4a3.3 3.3 0 1 1 0-6.6 3.3 3.3 0 0 1 0 6.6zm5.3-9.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z',
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5z',
};
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script src="/push.js" defer></script>
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={ogImage} />
  {image?.startsWith('/images/posts/') && <meta property="og:image:width" content="1200" />}
  {image?.startsWith('/images/posts/') && <meta property="og:image:height" content="675" />}
  <meta property="og:image:alt" content={imageAlt ?? title} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  {section && <meta property="article:section" content={section} />}
  {tags.map((t) => <meta property="article:tag" content={t} />)}
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt ?? title} />
  <meta name="theme-color" content="#e10600" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {SITE.ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>}
  {SITE.ga4Id && <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', ga4Id);
  </script>}
  {SITE.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label="Top ABC News home"><img src="/logo.svg" alt="ABC News" width="86" height="50" /></a>
      <button class="menu-btn" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
      <nav class="main-nav">
        <a href="/">Home</a>
        {NAV.map((n) => n.children ? (
          <div class="nav-group">
            {n.slug ? <a href={`/category/${n.slug}/`} class="nav-top">{n.label} <span class="caret">▾</span></a> : <button type="button" class="nav-top">{n.label} <span class="caret">▾</span></button>}
            <div class="nav-drop">
              {n.children.map((s) => { const c = catBySlug(s)!; return <a href={`/category/${c.slug}/`}>{c.name}</a>; })}
            </div>
          </div>
        ) : <a href={`/category/${n.slug}/`}>{n.label}</a>)}
      </nav>
      <a href="/search/" class="search-link" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <img src="/logo.svg" alt="ABC News" width="86" height="50" />
        <p>{SITE.tagline}. Daily updates on world news, technology, finance, sports, health, science, entertainment, education, automobiles and Indian government schemes.</p>
        <div class="social-links">
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={`Top ABC News on ${s.name}`} title={s.name}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICONS[s.name]} /></svg>
            </a>
          ))}
        </div>
      </div>
      <div><h4>Categories</h4>{CATEGORIES.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}</div>
      <div><h4>About</h4><a href="/about-us/">About Us</a><a href="/our-mission/">Our Mission</a><a href="/editorial-policy/">Editorial Policy</a><a href="/dnpa-code-of-ethics/">DNPA Code of Ethics</a><a href="/career/">Careers</a></div>
      <div><h4>Support</h4><a href="/contact/">Contact Us</a><a href="/faqs/">FAQs</a><a href="/advertise-with-us/">Advertise With Us</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-conditions/">Terms &amp; Conditions</a><a href="/legal-info/">Legal Info</a></div>
    </div>
    <div class="wrap copyright">© {year} {SITE.name}. All rights reserved.</div>
  </footer>
</body>
</html>

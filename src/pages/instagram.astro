---
// Link-in-bio page for Instagram: newest stories as tappable tiles.
// Shows only stories whose social post image is still in public/social/ (publish.py keeps the last 3 days).
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { allPosts } from '../lib/posts';

const socialDir = path.join(process.cwd(), 'public', 'social');
const socialImg = new Map<string, string>();
if (fs.existsSync(socialDir)) {
  for (const day of fs.readdirSync(socialDir).sort()) {
    const dir = path.join(socialDir, day);
    if (!fs.statSync(dir).isDirectory()) continue;
    for (const f of fs.readdirSync(dir)) if (f.endsWith('.jpg')) socialImg.set(f.slice(0, -4), `/social/${day}/${f}`);
  }
}
const utm = '?utm_source=instagram&utm_medium=social&utm_campaign=link_in_bio';
const posts = (await allPosts())
  .filter((p) => socialImg.has(p.data.slug))
  .slice(0, 60)
  .map((p) => ({ slug: p.data.slug, title: p.data.title, social: socialImg.get(p.data.slug)! }));
---
<Base title="Latest Stories from Instagram" description="Tap any picture to read the full story from the Top ABC News Instagram feed." noindex>
  <section class="wrap ig">
    <h1>Tap a picture to read the story</h1>
    <p class="ig-sub">Newest first, the same posts you see on our Instagram.</p>
    <div class="ig-grid">
      {posts.map((p) => (
        <a class="ig-tile" href={`/${p.slug}/${utm}`}>
          <img src={p.social} alt={p.title} loading="lazy" width="1080" height="1350" />
        </a>
      ))}
    </div>
    <div class="center ig-more"><a class="btn" href="/">All news on topabcnews.com</a></div>
  </section>
</Base>

<style>
  .ig { padding-top: 16px; padding-bottom: 32px; }
  .ig h1 { font-size: 1.35rem; margin: 0 0 4px; }
  .ig-sub { margin: 0 0 16px; color: #555; font-size: .95rem; }
  .ig-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  @media (min-width: 640px) { .ig-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .ig-grid { grid-template-columns: repeat(4, 1fr); } }
  .ig-tile { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 6px; background: #111; }
  .ig-tile > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ig-more { margin-top: 20px; }
</style>

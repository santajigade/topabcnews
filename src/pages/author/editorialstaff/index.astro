---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { allPosts } from '../../../lib/posts';
const posts = (await allPosts()).slice(0, 24);
---
<Base title="Editorial Staff" description="Stories by the Top ABC News editorial team.">
  <section class="wrap listing">
    <h1>Editorial Staff</h1>
    <p class="intro">The Top ABC News editorial desk covers daily news across technology, finance, health, education, government schemes, sports, automobiles and entertainment. Read our <a href="/editorial-policy/">editorial policy</a>.</p>
    <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>

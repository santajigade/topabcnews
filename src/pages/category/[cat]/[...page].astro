---
import Base from '../../../layouts/Base.astro';
import Listing from '../../../components/Listing.astro';
import { allPosts } from '../../../lib/posts';
import { CATEGORIES, PER_PAGE } from '../../../lib/site';
export async function getStaticPaths({ paginate }) {
  const posts = await allPosts();
  return CATEGORIES.flatMap((c) =>
    paginate(posts.filter((p) => p.data.category === c.name), { params: { cat: c.slug }, props: { c }, pageSize: PER_PAGE }));
}
const { page, c } = Astro.props;
---
<Base title={`${c.name} News`} description={`Latest ${c.name} news and updates from Top ABC News.`} noindex={page.currentPage > 1}>
  <Listing page={page} base={`/category/${c.slug}/`} heading={`${c.name} News`} intro={page.data.length ? undefined : 'New stories coming soon.'} />
</Base>

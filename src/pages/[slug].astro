---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Ad from '../components/Ad.astro';
import { allPosts } from '../lib/posts';
import { SITE, catByName, fmtDate } from '../lib/site';
export async function getStaticPaths() {
  const posts = await allPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'post', posts } })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, kind: 'page' } })),
  ];
}
const { entry, kind, posts } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
let jsonld, related = [], latestOther = [], cat, next;
if (kind === 'post') {
  cat = catByName(d.category);
  const idx = posts.findIndex((p) => p.data.slug === d.slug);
  next = posts[(idx + 1) % posts.length];
  related = posts.filter((p) => p.data.category === d.category && p.data.slug !== d.slug).slice(0, 4);
  latestOther = posts.filter((p) => p.data.category !== d.category).slice(0, 6);
  const url = `${SITE.url}/${d.slug}/`;
  jsonld = {
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'NewsArticle', headline: d.title, description: d.description, mainEntityOfPage: url,
        image: d.image ? [new URL(d.image, SITE.url).href] : undefined,
        datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
        articleSection: d.category, keywords: d.keywords,
        author: { '@type': 'Organization', name: 'Top ABC News Editorial Staff', url: `${SITE.url}/author/editorialstaff/` },
        publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } } },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: d.category, item: `${SITE.url}/category/${cat.slug}/` },
        { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
    ],
  };
}
---
<Base title={d.title} description={d.description} image={kind === 'post' ? d.image : undefined} type={kind === 'post' ? 'article' : 'website'} jsonld={jsonld}
  imageAlt={kind === 'post' ? (d.imageAlt ?? d.title) : undefined}
  publishedTime={kind === 'post' ? d.date : undefined} modifiedTime={kind === 'post' ? (d.updated ?? d.date) : undefined}
  section={kind === 'post' ? d.category : undefined} tags={kind === 'post' ? (d.tags ?? []) : []} keywords={kind === 'post' ? d.keywords : undefined}>
  <article class="wrap article" data-title={d.title} data-url={`/${d.slug}/`} data-next={next ? `/${next.data.slug}/` : undefined}>
    {kind === 'post' && (
      <>
        <nav class="crumbs"><a href="/">Home</a> › <a href={`/category/${cat.slug}/`}>{d.category}</a></nav>
        <a href={`/category/${cat.slug}/`} class="badge" style={`background:${cat.color}`}>{d.category}</a>
      </>
    )}
    <h1>{d.title}</h1>
    {kind === 'post' && (
      <div class="meta">By <a href="/author/editorialstaff/">Editorial Staff</a> · <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></>}</div>
    )}
    {kind === 'post' && d.image && <img class="hero" src={d.image} alt={d.imageAlt ?? d.title} width="1200" height="675" fetchpriority="high" />}
    <div class="prose"><Content /></div>
    {latestOther.length > 0 && (
      <aside class="prose latest-links"><h2>Latest News</h2><ul>
        {latestOther.map((p) => <li><a href={`/${p.data.slug}/`}>{p.data.title}</a></li>)}
      </ul></aside>
    )}
    <Ad />
  </article>
  {related.length > 0 && (
    <section class="wrap cat-section"><div class="sec-head"><h2 style={`border-color:${cat.color}`}>More {d.category} News</h2></div>
      <div class="grid">{related.map((p) => <PostCard post={p} />)}</div></section>
  )}
  {kind === 'post' && (
    <>
      <div id="next-sentinel" class="next-loading" aria-hidden="true"></div>
      <script is:inline>
      (() => {
        const MAX = 6; let loaded = 1, busy = false;
        const sentinel = document.getElementById('next-sentinel');
        const seen = new Set([location.pathname]);
        const lastArticle = () => [...document.querySelectorAll('article.article')].pop();
        const io = new IntersectionObserver(async (es) => {
          if (!es[0].isIntersecting || busy || loaded >= MAX) return;
          const next = lastArticle().dataset.next;
          if (!next || seen.has(next)) return io.disconnect();
          busy = true; sentinel.textContent = 'Loading next story...';
          try {
            const html = await (await fetch(next)).text();
            const art = new DOMParser().parseFromString(html, 'text/html').querySelector('article.article');
            if (!art) return io.disconnect();
            const sep = document.createElement('div'); sep.className = 'next-sep'; sep.textContent = 'Next story';
            sentinel.before(sep, art); seen.add(next); loaded++;
            art.querySelectorAll('ins.adsbygoogle').forEach(() => { try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {} });
          } catch (e) { io.disconnect(); }
          sentinel.textContent = ''; busy = false;
        }, { rootMargin: '600px' });
        io.observe(sentinel);
        // keep URL and title in sync with the story being read
        const urlIO = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting && location.pathname !== e.target.dataset.url) {
            history.replaceState(null, '', e.target.dataset.url);
            document.title = e.target.dataset.title + ' | Top ABC News';
            // count each infinite scroll story as its own page view in GA4
            if (window.gtag) gtag('event', 'page_view', { page_location: location.href, page_path: e.target.dataset.url, page_title: document.title });
          }
        }), { rootMargin: '-45% 0px -50% 0px' });
        new MutationObserver(() => document.querySelectorAll('article.article').forEach((a) => urlIO.observe(a)))
          .observe(document.querySelector('main'), { childList: true });
        document.querySelectorAll('article.article').forEach((a) => urlIO.observe(a));
      })();
      </script>
    </>
  )}
</Base>

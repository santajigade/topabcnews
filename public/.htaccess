# Top ABC News static site (replaces WordPress)
DirectoryIndex index.html
Options -Indexes

# Stop serving old WordPress pages from LiteSpeed server cache
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
<IfModule mod_headers.c>
  Header set X-LiteSpeed-Cache-Control "no-cache"
</IfModule>
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType application/rss+xml .xml
AddType image/webp .webp

# Block old WordPress PHP files left on the server
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Force https and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://topabcnews.com/$1 [R=301,L]

# Old WordPress URLs
RewriteRule ^feed/?$ /rss.xml [R=301,L]
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^category/([^/]+)/feed/?$ /category/$1/ [R=301,L]
RewriteRule ^(sitemap_index|post-sitemap|page-sitemap|category-sitemap|sitemap)\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap-index.xml [R=301,L]
RewriteRule ^sitemap-news\.xml$ /news-sitemap.xml [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php)(/.*)?$ / [R=301,L]
RewriteRule ^(home-[0-9]+|sample-page|refund_returns|bookmarks|content-widgets|our-team|categories-list|login|login-custom|newsletter|landing|reviews|blog|out-authors|authors-list|resources|maintenance|coming-soon|footer-styles|advanced-search|catalogue|faq)/?$ / [R=301,L]
RewriteRule ^(bollywood|technology|health|finance|education|yojana|sports|automobile)/?$ /category/$1/ [R=301,L]
RewriteRule ^tag/.*$ / [R=301,L]
# Old WordPress query links: ?p=123 shortlinks and ?paged=N (drop the query)
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|paged|cat)= [NC]
RewriteRule ^$ /? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|paged|cat)= [NC]
RewriteRule ^(world|technology|finance|sports|health|science|entertainment|bollywood|education|automobile|yojana)/?$ /category/$1/? [R=301,L]
# Old WordPress category pagination, e.g. /technology/page/2/ -> /category/technology/2/
RewriteRule ^(world|technology|finance|sports|health|science|entertainment|bollywood|education|automobile|yojana)/page/([0-9]+)/?$ /category/$1/$2/ [R=301,L]
# Truncated old link seen in Search Console
RewriteRule ^technology/end-to-end-/?$ /end-to-end-encryption-to-arattai/ [R=301,L]
# Old WordPress article URLs with a category prefix, e.g. /education/slug/ -> /slug/
RewriteRule ^(world|technology|finance|sports|health|science|entertainment|bollywood|education|automobile|yojana|news|uncategorized)/([a-z0-9-]+)/?$ /$2/ [R=301,L]
# Old WordPress date based URLs, e.g. /2025/09/06/slug/ -> /slug/
RewriteRule ^[0-9]{4}/[0-9]{2}/(?:[0-9]{2}/)?([a-z0-9-]+)/?$ /$1/ [R=301,L]
# Old WordPress category pagination and author pages
RewriteRule ^category/([^/]+)/page/1/?$ /category/$1/ [R=301,L]
RewriteRule ^author/(?!santaji-gadepatil/)[^/]+/?.*$ /author/santaji-gadepatil/ [R=301,L]
RewriteRule ^page/1/?$ / [R=301,L]
# Add missing trailing slash on clean URLs (avoids duplicate URL versions)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Service worker and push script must always be fresh
<FilesMatch "^(sw|push)\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xml "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
